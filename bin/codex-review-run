#!/usr/bin/env python3
"""CLI wrapper sharing codex-reviewer prompts, config, and detached background engine."""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
import time
from pathlib import Path
from typing import Any


def _load_sibling_module(name: str, script_path: Path) -> Any:
    """Load a Python module from an explicit path."""
    spec = importlib.util.spec_from_file_location(name, str(script_path))
    if spec and spec.loader:
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        spec.loader.exec_module(module)
        return module
    raise FileNotFoundError(f"Unable to load module {name} from {script_path}")


def load_codex_mcp_module() -> Any:
    """Locate and load codex_mcp.py from plugin environment or standard install paths."""
    candidates: list[Path] = []
    env_root = os.environ.get("PLUGIN_ROOT", "").strip()
    if env_root:
        candidates.append(Path(env_root))
    candidates.extend(
        [
            Path(__file__).resolve().parent.parent,
            Path.home() / ".gemini" / "config" / "plugins" / "codex-reviewer",
            Path.home() / ".local" / "share" / "codex-reviewer",
        ]
    )

    for root in candidates:
        script_path = root / "skills" / "codex-review" / "scripts" / "codex_mcp.py"
        if script_path.exists():
            return _load_sibling_module("codex_mcp", script_path)

    searched = ", ".join(str(p) for p in candidates)
    raise FileNotFoundError(f"Could not locate skills/codex-review/scripts/codex_mcp.py in: {searched}")


def read_prompt_input(prompt_file: str | None, content: str | None) -> str:
    """Load review packet or follow-up question from --prompt-file or --content."""
    if prompt_file:
        if prompt_file == "-":
            return sys.stdin.read()
        path = Path(prompt_file).expanduser()
        if not path.exists():
            raise FileNotFoundError(f"--prompt-file does not exist: {path}")
        return path.read_text(encoding="utf-8")
    if content is not None:
        return content
    return ""


def _wait_for_job_local(jobs_dir: Path, job_id: str, out_file: str | None) -> int:
    """Wait for job completion using codex-review-wait logic."""
    wait_candidates = [
        Path(__file__).resolve().parent / "codex-review-wait",
        Path.home() / ".local" / "bin" / "codex-review-wait",
        Path(__file__).resolve().parent.parent / "bin" / "codex-review-wait",
    ]
    for candidate in wait_candidates:
        if candidate.exists():
            wait_mod = _load_sibling_module("codex_review_wait", candidate)
            return int(wait_mod.wait_for_job(job_id, poll_interval=1.0, out_file=out_file))

    job_dir = jobs_dir / job_id
    done_path = job_dir / "done.json"
    report_path = job_dir / "report.md"
    while not done_path.exists():
        time.sleep(1.0)
    done = json.loads(done_path.read_text(encoding="utf-8"))
    report_text = report_path.read_text(encoding="utf-8").strip() if report_path.exists() else ""
    saved_path = report_path
    if out_file:
        saved_path = Path(out_file).expanduser()
        saved_path.parent.mkdir(parents=True, exist_ok=True)
        saved_path.write_text(report_text + "\n", encoding="utf-8")
    print(f"- **saved_report**: `{saved_path}`\n")
    print(report_text)
    return 1 if done.get("is_error") else 0


def build_parser() -> argparse.ArgumentParser:
    """Build CLI argument parser for background/long-running Codex reviews."""
    parser = argparse.ArgumentParser(
        prog="codex-review-run",
        description=(
            "Launch a non-interactive read-only Codex review (or session follow-up) via CLI. "
            "Runs with zero timeout limit by default."
        ),
    )
    parser.add_argument("--mode", help=argparse.SUPPRESS)
    parser.add_argument("--workspace", help="Absolute or relative workspace directory (-C).")
    parser.add_argument(
        "--prompt-file",
        help="Path to markdown review packet or follow-up question ('-' reads stdin).",
    )
    parser.add_argument("--content", help="Inline review packet or follow-up question.")
    parser.add_argument(
        "--focus",
        action="append",
        default=[],
        help="Key file path to inspect (repeatable).",
    )
    parser.add_argument(
        "--git-scope",
        help="Git diff scope: uncommitted, base:<branch>, or commit:<sha>.",
    )
    parser.add_argument("--extra", help="Additional review instructions.")
    parser.add_argument(
        "--followup",
        metavar="SESSION_ID",
        help="Resume an existing Codex session_id for a follow-up question.",
    )
    parser.add_argument("--model", help="One-off model slug or alias override.")
    parser.add_argument("--effort", help="One-off reasoning effort override.")
    parser.add_argument(
        "--timeout",
        type=int,
        default=None,
        help="One-off timeout in seconds (0 = unlimited). Defaults to config.json setting.",
    )
    parser.add_argument(
        "--detach",
        action="store_true",
        help="Print launched job_id JSON and exit immediately instead of waiting for completion.",
    )
    parser.add_argument(
        "--out",
        help="Optional extra markdown path to copy the finished report.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    """Launch background Codex job, then detach or wait for completion."""
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        codex_mcp = load_codex_mcp_module()
        text_input = read_prompt_input(args.prompt_file, args.content)

        if args.followup:
            payload: dict[str, Any] = {
                "session_id": args.followup,
                "question": text_input,
            }
            if args.workspace:
                payload["workspace_dir"] = args.workspace
            if args.model:
                payload["model"] = args.model
            if args.effort:
                payload["reasoning_effort"] = args.effort
            if args.timeout is not None:
                payload["timeout_sec"] = args.timeout
            result = codex_mcp.handle_codex_followup(payload)
        else:
            payload = {
                "content": text_input,
            }
            if args.workspace:
                payload["workspace_dir"] = args.workspace
            if args.focus:
                payload["focus_files"] = args.focus
            if args.git_scope:
                payload["git_scope"] = args.git_scope
            if args.extra:
                payload["extra_instructions"] = args.extra
            if args.model:
                payload["model"] = args.model
            if args.effort:
                payload["reasoning_effort"] = args.effort
            if args.timeout is not None:
                payload["timeout_sec"] = args.timeout
            result = codex_mcp.handle_codex_review(payload)

        launch_text = result["content"][0]["text"]
        if args.detach:
            print(launch_text)
            return 0

        launch_info = json.loads(launch_text)
        job_id = str(launch_info["job_id"])
        return _wait_for_job_local(codex_mcp.JOBS_DIR, job_id, args.out)
    except Exception as exc:  # noqa: BLE001
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
